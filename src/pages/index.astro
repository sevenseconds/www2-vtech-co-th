---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
import ServiceCard from '../components/ServiceCard.astro';
import BlogCard from '../components/BlogCard.astro';
import TeamMember from '../components/TeamMember.astro';
import { getCollection } from 'astro:content';

// Fetch content
const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const blogPosts = (await getCollection('blog')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).slice(0, 3);
const teamMembers = (await getCollection('team')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="CoLabs - Professional Laboratory Services">
  <Header />
  
  <!-- Hero Section -->
  <Hero 
    title="Professional Laboratory Excellence"
    subtitle="Cutting-edge diagnostic services with state-of-the-art technology and expert analysis for accurate, reliable results."
    ctaText="Explore Our Services"
    ctaLink="/services"
  />
  
  <!-- Services Section -->
  <section class="section-padding bg-white">
    <div class="container-custom">
      <div class="text-center mb-16">
        <h2 class="text-4xl md:text-5xl font-bold mb-4 text-gradient">Our Services</h2>
        <p class="text-xl text-slate-600 max-w-2xl mx-auto">
          Comprehensive laboratory testing services powered by advanced technology and experienced professionals
        </p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {services.map(service => (
          <ServiceCard 
            title={service.data.title}
            description={service.data.description}
            icon={service.data.icon}
          />
        ))}
      </div>
      
      <div class="text-center mt-12">
        <a href="/services" class="btn btn-primary">
          View All Services
          <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
          </svg>
        </a>
      </div>
    </div>
  </section>
  
  <!-- Stats Section -->
  <section class="section-padding bg-gradient-to-r from-blue-900 to-blue-700 text-white">
    <div class="container-custom">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-12">
        <div class="text-center">
          <div class="text-5xl font-bold mb-2">25,000+</div>
          <div class="text-xl text-blue-200">Tests Completed</div>
        </div>
        <div class="text-center">
          <div class="text-5xl font-bold mb-2">98.5%</div>
          <div class="text-xl text-blue-200">Accuracy Rate</div>
        </div>
        <div class="text-center">
          <div class="text-5xl font-bold mb-2">15+</div>
          <div class="text-xl text-blue-200">Years Experience</div>
        </div>
      </div>
    </div>
  </section>
  
  <!-- Team Section -->
  <section class="section-padding bg-slate-50">
    <div class="container-custom">
      <div class="text-center mb-16">
        <h2 class="text-4xl md:text-5xl font-bold mb-4 text-gradient">Our Team</h2>
        <p class="text-xl text-slate-600 max-w-2xl mx-auto">
          Meet our experienced laboratory professionals dedicated to delivering exceptional service
        </p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
        {teamMembers.map(member => (
          <TeamMember 
            name={member.data.name}
            role={member.data.role}
            photo={member.data.photo}
            bio={member.data.bio}
            linkedin={member.data.linkedin}
            twitter={member.data.twitter}
          />
        ))}
      </div>
    </div>
  </section>
  
  <!-- Blog Section -->
  <section class="section-padding bg-white">
    <div class="container-custom">
      <div class="text-center mb-16">
        <h2 class="text-4xl md:text-5xl font-bold mb-4 text-gradient">Latest Insights</h2>
        <p class="text-xl text-slate-600 max-w-2xl mx-auto">
          Stay informed with our latest articles on laboratory science and healthcare innovations
        </p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {blogPosts.map(post => (
          <BlogCard 
            title={post.data.title}
            description={post.data.description}
            pubDate={post.data.pubDate}
            image={post.data.image}
            slug={post.slug}
            tags={post.data.tags}
          />
        ))}
      </div>
      
      <div class="text-center mt-12">
        <a href="/blog" class="btn btn-primary">
          Read More Articles
          <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
          </svg>
        </a>
      </div>
    </div>
  </section>
  
  <!-- CTA Section -->
  <section class="section-padding bg-gradient-to-r from-blue-900 to-blue-700 text-white">
    <div class="container-custom text-center">
      <h2 class="text-4xl md:text-5xl font-bold mb-6">Ready to Get Started?</h2>
      <p class="text-xl text-blue-100 mb-8 max-w-2xl mx-auto">
        Contact us today to learn more about our laboratory services and how we can support your diagnostic needs
      </p>
      <a href="/contact" class="btn btn-secondary text-lg">
        Contact Us Today
        <svg class="w-6 h-6 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
        </svg>
      </a>
    </div>
  </section>
  
  <Footer />
</BaseLayout>
