---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Hero from '../../components/Hero.astro';
import BlogCard from '../../components/BlogCard.astro';
import { getCollection } from 'astro:content';

const allPosts = (await getCollection('blog')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout title="Blog - CoLabs" description="Latest insights on laboratory science, healthcare innovations, and testing advancements.">
  <Header />
  
  <Hero 
    title="Laboratory Insights & News"
    subtitle="Stay informed with our latest articles on laboratory science, healthcare innovations, and testing advancements"
  />
  
  <section class="section-padding bg-white">
    <div class="container-custom">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {allPosts.map(post => (
          <BlogCard 
            title={post.data.title}
            description={post.data.description}
            pubDate={post.data.pubDate}
            image={post.data.image}
            slug={post.slug}
            tags={post.data.tags}
          />
        ))}
      </div>
    </div>
  </section>
  
  <Footer />
</BaseLayout>
