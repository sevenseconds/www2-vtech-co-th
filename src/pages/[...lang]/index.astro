---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import SliderHero from '../../components/SliderHero.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import TestimonialSlider from '../../components/TestimonialSlider.astro';
import { getCollection } from 'astro:content';
import { useTranslations } from '../../i18n/utils';

export function getStaticPaths() {
  return [
    { params: { lang: undefined } },
    { params: { lang: 'en' } },
  ];
}

const { lang: langParam } = Astro.params;
const lang = langParam || 'th';
const t = useTranslations(lang as 'en' | 'th');

// Fetch content
const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const posts = (await getCollection('blog')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).slice(0, 3);
const projects = (await getCollection('projects')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0, 6);

const slides = [
  {
    title: "A PASSION FOR BETTER MEDICINE.",
    subtitle: "Leadership through innovation. We provide comprehensive diagnostic services powered by advanced technology.",
    backgroundImage: "/images/hero-1.png",
    category: "RESEARCH & SCIENCE"
  },
  {
    title: "INNOVATIVE LAB SOLUTIONS.",
    subtitle: "State-of-the-art laboratory equipment and expert analysis for accurate, reliable results every time.",
    backgroundImage: "/images/hero-2.png",
    category: "MEDICAL EXCELLENCE"
  },
  {
    title: "TRUSTED BY PROFESSIONALS.",
    subtitle: "More than 500+ clinics and hospitals trust our diagnostic precision and rapid turnaround times.",
    backgroundImage: "/images/hero-3.png",
    category: "QUALITY CARE"
  }
];
---

<BaseLayout title={t('site.title')} lang={lang}>
  <!-- Start: Header Component -->
  <Header />
  <!-- End: Header Component -->
  
  <!-- Start: SliderHero Section -->
  <SliderHero slides={slides} />
  <!-- End: SliderHero Section -->
  
  <!-- Start: Mini Services Section -->
  <section class="pt-40 pb-24 bg-white border-b border-slate-50">
    <div class="container-custom">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-12">
        <div class="space-y-4">
          <div class="text-[10px] font-bold text-slate-300 uppercase tracking-widest">01.</div>
          <h4 class="text-xl font-bold font-heading">High Quality results</h4>
          <p class="text-sm text-slate-500 leading-relaxed">We maintain the highest standards of accuracy and precision in every test we perform.</p>
        </div>
        <div class="space-y-4">
          <div class="text-[10px] font-bold text-slate-300 uppercase tracking-widest">02.</div>
          <h4 class="text-xl font-bold font-heading">Innovation & Science</h4>
          <p class="text-sm text-slate-500 leading-relaxed">Utilizing cutting-edge technology and modern methodologies for chemical and medical research.</p>
        </div>
        <div class="space-y-4">
          <div class="text-[10px] font-bold text-slate-300 uppercase tracking-widest">03.</div>
          <h4 class="text-xl font-bold font-heading">Strict Concentration</h4>
          <p class="text-sm text-slate-500 leading-relaxed">Our focused approach ensures rapid turnaround times without compromising on quality.</p>
        </div>
      </div>
    </div>
  </section>
  <!-- End: Mini Services Section -->

  <!-- Start: Technology & Company Section -->
  <section class="section-padding bg-white overflow-hidden">
    <div class="container-custom">
      <div class="flex flex-col lg:flex-row items-center gap-16">
        <div class="lg:w-1/2 space-y-8">
          <h2 class="text-4xl md:text-5xl font-bold font-heading leading-tight uppercase">
            We employ the latest <br/><span class="text-primary">Technology & Expertise</span>
          </h2>
          <p class="text-slate-600 leading-relaxed">
            Leading diagnostic center in Thailand providing high-quality reports using state-of-the-art laboratory equipment.
          </p>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            {['Expert Doctors', 'Reliable Reports', 'Modern Equipments', 'Patient Care', 'Online Results', 'Quick Appointment'].map(item => (
              <div class="flex items-center space-x-3 group">
                <div class="w-2 h-2 rounded-full bg-primary group-hover:scale-125 transition-transform"></div>
                <span class="font-bold text-xs uppercase tracking-widest text-secondary">{item}</span>
              </div>
            ))}
          </div>
          <a href={lang === 'en' ? '/about' : `/${lang}/about`} class="btn btn-primary">Learn More</a>
        </div>
        <div class="lg:w-1/2 relative">
          <img src="/images/tech-section.png" alt="Laboratory Scientist" class="rounded-2xl shadow-2xl relative z-10" />
          <div class="absolute -bottom-10 -right-10 w-64 h-64 bg-slate-50 rounded-full -z-10"></div>
        </div>
      </div>
    </div>
  </section>
  <!-- End: Technology & Company Section -->

  <!-- Start: Case Studies Section -->
  <section class="relative overflow-hidden">
    <div class="absolute inset-0 bg-primary h-[50%] -z-10"></div>
    <div class="container-custom py-12 relative z-10">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-16 space-y-4 md:space-y-0 text-white">
        <div>
          <h2 class="text-4xl md:text-5xl font-heading text-white uppercase tracking-tight font-normal">
            Latest <span class="font-black">Cases Studies</span>
          </h2>
        </div>
        <a href={lang === 'en' ? '/projects' : `/${lang}/projects`} class="px-6 py-2 border border-white text-[10px] font-bold uppercase tracking-widest hover:bg-white hover:text-primary transition-all">VIEW ALL</a>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-5xl mx-auto">
        {projects.map((project, i) => (
          <div class="group relative overflow-hidden aspect-square bg-slate-900 shadow-xl cursor-pointer">
            <img 
              src={project.data.images[0]} 
              alt={project.data.title} 
              class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700 opacity-90 group-hover:opacity-100" 
            />
            
            {/* Overlay */}
            <div class="absolute inset-0 bg-primary/90 opacity-0 group-hover:opacity-100 transition-all duration-500 flex flex-col items-center justify-center p-8 text-center">
              
              {/* Animated Border Frame */}
              <div class="absolute inset-6 border border-white/30 scale-110 opacity-0 group-hover:scale-100 group-hover:opacity-100 transition-all duration-500 pointer-events-none"></div>
              
              {/* Content */}
              <div class="relative z-10 translate-y-8 group-hover:translate-y-0 opacity-0 group-hover:opacity-100 transition-all duration-500 delay-100">
                <span class="block text-[10px] font-bold tracking-[0.4em] text-white/80 uppercase mb-4">
                  {project.data.category}
                </span>
                <h4 class="text-xl md:text-2xl font-bold text-white uppercase leading-tight font-heading">
                  {project.data.title}
                </h4>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
  <!-- End: Case Studies Section -->

  <!-- Start: Experts Section -->
  <section class="section-padding bg-slate-50 relative overflow-hidden">
    <!-- Decorative background elements -->
    <div class="absolute top-0 right-0 w-96 h-96 bg-primary/5 rounded-full blur-3xl -z-10 translate-x-1/2 -translate-y-1/2"></div>
    <div class="absolute bottom-0 left-0 w-96 h-96 bg-secondary/5 rounded-full blur-3xl -z-10 -translate-x-1/2 translate-y-1/2"></div>
    
    <div class="container-custom">
      <div class="text-center max-w-3xl mx-auto mb-20">
        <div class="text-[10px] font-bold text-primary uppercase tracking-[0.4em] mb-4">Our Core Expertise</div>
        <h2 class="text-4xl md:text-5xl font-bold font-heading uppercase leading-tight">We are the trusted <br/><span class="text-primary italic">Clinical</span> Diagnostic experts</h2>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-3 gap-10">
        {[
          { 
            title: 'Pathology', 
            desc: 'Expert analysis of tissues and fluids for accurate disease diagnosis and staging.', 
            icon: '<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6 18h8"/><path d="M3 22h18"/><path d="M14 22a7 7 0 1 0 0-14h-1"/><path d="M9 14h2"/><path d="M9 12a2 2 0 1 0-2-2v6"/><path d="M12 6V3a1 1 0 0 0-1-1H9a1 1 0 0 0-1 1v3"/></svg>' 
          },
          { 
            title: 'Genetics', 
            desc: 'Comprehensive DNA sequencing and genetic counseling for hereditary conditions.', 
            icon: '<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="m8 16 8-8"/><path d="m8 8 8 8"/><path d="m13 3 8 8"/><path d="m3 13 8 8"/></svg>' 
          },
          { 
            title: 'Microbiology', 
            desc: 'Identification of bacterial, viral, and fungal pathogens with drug sensitivity testing.', 
            icon: '<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M10 2v7.5"/><path d="M14 2v7.5"/><path d="M8.5 13H15.5"/><path d="M5.5 18a2 2 0 0 1-1.33-3.13l5.33-7.37H14.5l5.33 7.37A2 2 0 0 1 18.5 18H5.5Z"/></svg>' 
          }
        ].map((item, idx) => (
          <div class="bg-white p-12 rounded-3xl shadow-[0_10px_40px_rgba(0,0,0,0.03)] hover:shadow-[0_20px_60px_rgba(0,0,0,0.08)] transition-all duration-500 group border border-slate-100 flex flex-col h-full text-center">
            <div class="w-20 h-20 mx-auto bg-slate-50 rounded-2xl flex items-center justify-center text-primary mb-8 group-hover:bg-primary group-hover:rotate-6 transition-all duration-500 group-hover:shadow-lg group-hover:shadow-primary/20">
              <span class="group-hover:text-white transition-colors duration-500" set:html={item.icon}></span>
            </div>
            <h4 class="text-2xl font-bold font-heading uppercase tracking-tight mb-4 text-secondary group-hover:text-primary transition-colors">{item.title}</h4>
            <p class="text-slate-500 leading-relaxed text-sm mb-8">{item.desc}</p>
            <div class="mt-auto">
              <div class="w-10 h-1 bg-slate-100 mx-auto group-hover:w-20 group-hover:bg-primary transition-all duration-500"></div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
  <!-- End: Experts Section -->

  <!-- Start: Testimonials Section -->
  <TestimonialSlider />
  <!-- End: Testimonials Section -->

  <!-- Start: Statistics & Map Section -->
  <section class="section-padding bg-white overflow-hidden">
    <div class="container-custom">
      <div class="flex flex-col lg:flex-row items-center gap-20">
        <div class="lg:w-1/2 space-y-12">
          <div class="grid grid-cols-2 gap-12 text-center sm:text-left">
            <div>
              <div class="text-4xl lg:text-5xl font-bold font-heading text-primary mb-2">15+</div>
              <div class="uppercase tracking-widest text-[10px] font-bold text-slate-400">Years Exp.</div>
            </div>
            <div>
              <div class="text-4xl lg:text-5xl font-bold font-heading text-primary mb-2">500k+</div>
              <div class="uppercase tracking-widest text-[10px] font-bold text-slate-400">Total Tests</div>
            </div>
            <div>
              <div class="text-4xl lg:text-5xl font-bold font-heading text-primary mb-2">50+</div>
              <div class="uppercase tracking-widest text-[10px] font-bold text-slate-400">Specialists</div>
            </div>
            <div>
              <div class="text-4xl lg:text-5xl font-bold font-heading text-primary mb-2">100+</div>
              <div class="uppercase tracking-widest text-[10px] font-bold text-slate-400">Partner Clinics</div>
            </div>
          </div>
          
          <div class="space-y-6">
            <h3 class="text-3xl font-bold font-heading uppercase">We are trusted by <span class="text-primary italic">Thailand's</span> Leading hospitals</h3>
            <p class="text-sm text-slate-500 leading-relaxed">Our clinical laboratory is accredited by international standards, providing reliable results to over 100 partner clinics and hospitals across the country.</p>
            
            <div class="space-y-4">
              <div class="space-y-2">
                <div class="flex justify-between text-[11px] font-bold uppercase tracking-widest">
                  <span>Serum Medicine</span>
                  <span>95%</span>
                </div>
                <div class="h-1.5 w-full bg-slate-100">
                  <div class="h-full bg-primary" style="width: 95%"></div>
                </div>
              </div>
              <div class="space-y-2">
                <div class="flex justify-between text-[11px] font-bold uppercase tracking-widest">
                  <span>Laboratory</span>
                  <span>80%</span>
                </div>
                <div class="h-1.5 w-full bg-slate-100">
                  <div class="h-full bg-primary" style="width: 80%"></div>
                </div>
              </div>
            </div>
          </div>
        </div>
        
        <div class="lg:w-1/2 relative opacity-50 hover:opacity-100 transition-opacity">
          <img src="/images/world-map.png" alt="World Map" class="w-full" />
          <!-- Map hot spots -->
          <div class="absolute top-[30%] left-[20%] w-3 h-3 bg-primary rounded-full animate-ping"></div>
          <div class="absolute top-[45%] left-[55%] w-3 h-3 bg-secondary rounded-full animate-ping"></div>
          <div class="absolute top-[60%] left-[80%] w-3 h-3 bg-primary rounded-full animate-ping"></div>
        </div>
      </div>
    </div>
  </section>
  <!-- End: Statistics & Map Section -->

  <!-- Start: Blog Section -->
  <section class="section-padding bg-slate-100">
    <div class="container-custom">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-16 space-y-4 md:space-y-0">
        <div>
          <div class="text-[10px] font-bold text-primary uppercase tracking-[0.4em] mb-4">Latest news & blogs</div>
          <h2 class="text-4xl md:text-5xl font-bold font-heading uppercase">Read our latest blog posts</h2>
        </div>
        <a href={lang === 'en' ? '/blog' : `/${lang}/blog`} class="btn btn-primary">All Blog Posts</a>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-3 gap-10">
        {posts.map(post => (
          <div class="bg-white shadow-xl hover:-translate-y-2 transition-transform duration-300 flex flex-col h-full group">
            <div class="relative overflow-hidden aspect-video">
              <img src={post.data.image} alt={post.data.title} class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700" />
              <div class="absolute top-4 left-4 bg-primary text-white text-[10px] font-bold px-3 py-1 uppercase tracking-widest">Laboratory</div>
            </div>
            <div class="p-8 flex flex-col flex-grow">
              <div class="text-[11px] font-bold text-slate-400 uppercase tracking-widest mb-4">
                {post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
              </div>
              <a href={`/blog/${post.slug}`}>
                <h4 class="text-xl font-bold font-heading mb-4 hover:text-primary transition-colors cursor-pointer leading-tight uppercase line-clamp-2">
                  {post.data.title}
                </h4>
              </a>
              <p class="text-sm text-slate-500 mb-8 line-clamp-3">{post.data.description}</p>
              <div class="mt-auto flex items-center justify-between pt-6 border-t border-slate-50">
                <a href={lang === 'en' ? `/blog/${post.slug}` : `/${lang}/blog/${post.slug}`} class="text-[11px] font-bold text-secondary uppercase tracking-widest hover:text-primary transition-colors cursor-pointer">Read More</a>
                <svg class="w-4 h-4 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
  <!-- End: Blog Section -->

  <!-- Start: CTA Banner Section -->
  <div class="bg-primary py-16 relative overflow-hidden">
    <div class="absolute -right-20 -top-20 w-64 h-64 bg-white/5 rounded-full"></div>
    <div class="container-custom relative z-10 flex flex-col md:flex-row items-center justify-between text-white space-y-8 md:space-y-0 text-center md:text-left">
      <h3 class="text-2xl md:text-4xl font-bold font-heading uppercase tracking-wider leading-tight">
        The Best Diagnostic Center <br/>for your Health.
      </h3>
      <a href={lang === 'en' ? '/contact' : `/${lang}/contact`} class="bg-secondary text-white px-12 py-5 font-bold uppercase text-xs tracking-[0.2em] hover:bg-white hover:text-secondary transition-all duration-300 shadow-2xl">
        Contact Us Now
      </a>
    </div>
  </div>
  <!-- End: CTA Banner Section -->
  
  <!-- Start: Footer Component -->
  <Footer />
  <!-- End: Footer Component -->
</BaseLayout>
