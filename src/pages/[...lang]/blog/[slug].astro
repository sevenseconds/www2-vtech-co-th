---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import { useTranslations } from '../../../i18n/utils';

export async function getStaticPaths() {
  const blogPosts = await getCollection('blog');
  const langs = [undefined, 'en'];
  
  return langs.flatMap(lang => {
    return blogPosts.map(post => ({
      params: { lang, slug: post.slug },
      props: { post },
    }));
  });
}

const { post } = Astro.props;
const { lang: langParam } = Astro.params;
const lang = (langParam || 'th') as 'en' | 'th';
const t = useTranslations(lang);
const { Content } = await post.render();

const formattedDate = post.data.pubDate.toLocaleDateString(lang === 'en' ? 'en-US' : 'th-TH', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
});
---


<BaseLayout title={`${post.data.title} - V-TECH Blog`} description={post.data.description} lang={lang}>
  <Header />
  
  <article class="section-padding bg-white">
    <div class="max-w-4xl mx-auto px-4">
      <!-- Hero Image -->
      {post.data.image && (
        <div class="aspect-video bg-slate-100 rounded-2xl overflow-hidden mb-8">
          <img 
            src={post.data.image} 
            alt={post.data.title} 
            class="w-full h-full object-cover"
          />
        </div>
      )}
      
      <!-- Meta -->
      <div class="flex items-center gap-4 text-slate-600 mb-6">
        <div class="flex items-center gap-2">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
          </svg>
          <time datetime={post.data.pubDate.toISOString()}>{formattedDate}</time>
        </div>
        
        <div class="flex items-center gap-2">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
          </svg>
          <span>{post.data.author}</span>
        </div>
      </div>
      
      <!-- Title -->
      <h1 class="text-4xl md:text-5xl font-bold mb-6 text-blue-900">
        {post.data.title}
      </h1>
      
      <!-- Tags -->
      {post.data.tags && post.data.tags.length > 0 && (
        <div class="flex flex-wrap gap-2 mb-8">
          {post.data.tags.map(tag => (
            <span class="bg-blue-100 text-blue-900 px-4 py-2 rounded-full text-sm font-medium">
              {tag}
            </span>
          ))}
        </div>
      )}
      
      <!-- Content -->
      <div class="prose prose-lg prose-slate max-w-none
        prose-headings:text-blue-900 prose-headings:font-bold
        prose-a:text-blue-600 prose-a:no-underline hover:prose-a:underline
        prose-strong:text-slate-900
        prose-code:text-blue-800 prose-code:bg-blue-50 prose-code:px-1 prose-code:py-0.5 prose-code:rounded
        prose-pre:bg-slate-900">
        <Content />
      </div>
      
      <!-- Back to Blog -->
      <div class="mt-12 pt-8 border-t border-slate-200">
        <a href="/blog" class="inline-flex items-center text-blue-900 font-semibold hover:gap-3 gap-2 transition-all">
          <svg class="w-5 h-5 rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
          </svg>
          Back to Blog
        </a>
      </div>
    </div>
  </article>
  
  <Footer />
</BaseLayout>
