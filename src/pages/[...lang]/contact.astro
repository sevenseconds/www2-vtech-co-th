---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { useTranslations } from '../../i18n/utils';

export function getStaticPaths() {
  return [
    { params: { lang: undefined } },
    { params: { lang: 'en' } },
  ];
}

const { lang: langParam } = Astro.params;
const lang = langParam || 'th';
const t = useTranslations(lang as 'en' | 'th');
---

<BaseLayout title={`${t('nav.contacts')} - V-TECH`} description={t('site.description')} lang={lang}>
  <Header />

  <!-- Top Map Section -->
  <section class="bg-white py-24">
    <div class="container-custom h-[450px]">
      <iframe 
        src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3876.3304058691806!2d100.60675119999999!3d13.6984278!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x30e29fefc0ecc803%3A0x1528c0107a181af!2zOTEg4LiL4Lit4LiiIOC4quC4uOC4guC4uOC4oeC4p-C4tOC4lyA5NS8xIOC5geC4guC4p-C4h-C4muC4suC4h-C4iOC4suC4gSDguYDguILguJXguJ7guKPguLDguYLguILguJnguIcg4LiB4Lij4Li44LiH4LmA4LiX4Lie4Lih4Lir4Liy4LiZ4LiE4LijIDEwMjYw!5e0!3m2!1sth!2sth!4v1767896796811!5m2!1sth!2sth" 
        class="w-full h-full border-0" 
        allowfullscreen="" 
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade">
      </iframe>
    </div>
  </section>

  <!-- Contact Section -->
  <section class="pb-24 bg-white">
    <div class="container-custom">
      <div class="flex flex-col lg:flex-row gap-20">
        
        <!-- Left: Get in Touch -->
        <div class="lg:w-1/2 space-y-12">
          <div class="space-y-6">
            <h2 class="text-4xl font-bold font-heading text-secondary uppercase">Get in touch</h2>
            <p class="text-slate-500 leading-relaxed max-w-xl">
              We are committed to providing the highest standards of diagnostic precision and customer support. Whether you're a healthcare provider looking for laboratory solutions or have questions about our research services, our team is here to assist you with expert guidance and rapid response times.
            </p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-y-12 gap-x-8">
            <!-- Address -->
            <div class="flex items-start space-x-5">
              <div class="text-primary mt-1">
                <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
              </div>
              <div>
                <h4 class="text-sm font-bold text-secondary uppercase tracking-wider mb-1">Our Address</h4>
                <p class="text-slate-400 text-sm leading-relaxed">{t('contact.full_address')}</p>
              </div>
            </div>

            <!-- Phone -->
            <div class="flex items-start space-x-5">
              <div class="text-primary mt-1">
                <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l2.1-2.1a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
              </div>
              <div>
                <h4 class="text-sm font-bold text-secondary uppercase tracking-wider mb-1">Phone Number</h4>
                <div class="text-slate-400 text-sm space-y-1">
                  <p>02-742-5340 (Office)</p>
                  <p>092 537 8424 (Main)</p>
                </div>
              </div>
            </div>

            <!-- Email -->
            <div class="flex items-start space-x-5">
              <div class="text-primary mt-1">
                <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"></rect><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path></svg>
              </div>
              <div>
                <h4 class="text-sm font-bold text-secondary uppercase tracking-wider mb-1">Email Address</h4>
                <p class="text-slate-400 text-sm">{t('contact.email_value')}</p>
              </div>
            </div>

            <!-- Working Hours -->
            <div class="flex items-start space-x-5">
              <div class="text-primary mt-1">
                <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
              </div>
              <div>
                <h4 class="text-sm font-bold text-secondary uppercase tracking-wider mb-1">Working Hours</h4>
                <p class="text-slate-400 text-sm">Mon to Fri: 9am to 8pm</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Right: Drop us a Line -->
        <div class="lg:w-1/2">
          <h2 class="text-3xl font-bold font-heading text-secondary uppercase mb-10">Drop us a line</h2>
          <form class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <input type="text" placeholder="Your Name" class="w-full border border-slate-100 px-6 py-4 focus:ring-1 focus:ring-primary outline-none text-sm placeholder:text-slate-400" />
            <input type="email" placeholder="Your Email" class="w-full border border-slate-100 px-6 py-4 focus:ring-1 focus:ring-primary outline-none text-sm placeholder:text-slate-400" />
            <input type="text" placeholder="Your Phone" class="w-full border border-slate-100 px-6 py-4 focus:ring-1 focus:ring-primary outline-none text-sm placeholder:text-slate-400" />
            <input type="text" placeholder="Subject" class="w-full border border-slate-100 px-6 py-4 focus:ring-1 focus:ring-primary outline-none text-sm placeholder:text-slate-400" />
            <textarea placeholder="Message" rows="5" class="w-full border border-slate-100 px-6 py-4 focus:ring-1 focus:ring-primary outline-none text-sm placeholder:text-slate-400 md:col-span-2 resize-none"></textarea>
            <div class="md:col-span-2">
              <button type="submit" class="bg-primary text-white px-10 py-4 font-bold uppercase text-xs tracking-widest hover:bg-secondary transition-all">
                Send Message
              </button>
            </div>
          </form>
        </div>

      </div>
    </div>
  </section>

  <Footer />
</BaseLayout>
