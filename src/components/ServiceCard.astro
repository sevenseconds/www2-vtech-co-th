---
interface Props {
  title: string;
  description: string;
  icon: string;
}

const { title, description, icon } = Astro.props;
---

<div class="card group hover:scale-105">
  <div class="text-5xl mb-4 transform group-hover:scale-110 transition-transform duration-300">
    {icon}
  </div>
  <h3 class="text-xl font-bold mb-3 text-blue-900">{title}</h3>
  <p class="text-slate-600 leading-relaxed">{description}</p>
</div>
