---
interface Props {
  title: string;
  subtitle?: string;
  backgroundImage?: string;
  category?: string;
  ctaText?: string;
  ctaLink?: string;
}

const { title, subtitle, backgroundImage, category = "Research & Science", ctaText, ctaLink } = Astro.props;
---

<!-- Start: Hero Component -->
<section class="relative h-[650px] md:h-[800px] lg:h-[900px] overflow-hidden">
  <!-- Background Image with slight zoom effect -->
  <div class="absolute inset-0">
    <img src={backgroundImage} alt="" class="w-full h-full object-cover" />
    <div class="absolute inset-0 bg-black/5"></div>
  </div>
  
  <div class="relative container-custom h-full flex items-center">
    <!-- Floating Content Box -->
    <div class="bg-primary/95 text-white p-10 md:p-14 lg:p-20 max-w-xl animate-fade-in relative z-10 -mt-20 lg:-mt-32 shadow-2xl">
      <div class="bg-white text-primary px-5 py-1.5 inline-block text-[11px] font-bold uppercase tracking-[0.2em] mb-10 font-heading">
        {category}
      </div>
      
      <h1 class="text-4xl md:text-5xl lg:text-7xl font-bold mb-10 leading-[1.1] font-heading text-white uppercase tracking-tight">
        {title}
      </h1>
      
      {subtitle && (
        <p class="text-[15px] md:text-base text-white/90 mb-12 leading-relaxed max-w-md font-medium">
          {subtitle}
        </p>
      )}
      
      <div class="flex flex-col sm:flex-row space-y-4 sm:space-y-0 sm:space-x-6">
        <a href={ctaLink || "#"} class="text-[12px] font-bold uppercase tracking-[0.3em] border-b-2 border-white/40 pb-1 hover:text-white hover:border-white transition-all font-heading inline-block">
          Learn More
        </a>
      </div>
    </div>

    <!-- Slide Indicators / Arrows at bottom right -->
    <div class="absolute bottom-10 right-10 lg:bottom-20 lg:right-20 flex space-x-0 shadow-2xl">
      <button class="bg-primary/90 hover:bg-secondary text-white w-14 h-14 md:w-16 md:h-16 flex items-center justify-center transition-all duration-300 border-r border-white/10 group">
        <svg class="w-6 h-6 group-hover:-translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
      </button>
      <button class="bg-primary/90 hover:bg-secondary text-white w-14 h-14 md:w-16 md:h-16 flex items-center justify-center transition-all duration-300 group">
        <svg class="w-6 h-6 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
      </button>
    </div>
  </div>
</section>
<!-- End: Hero Component -->
