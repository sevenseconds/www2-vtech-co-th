---
interface Props {
  title: string;
  subtitle?: string;
  backgroundImage?: string;
  ctaText?: string;
  ctaLink?: string;
}

const { title, subtitle, backgroundImage, ctaText, ctaLink } = Astro.props;
---

<section class="relative bg-gradient-to-r from-blue-900 to-blue-700 text-white overflow-hidden">
  <!-- Hexagon pattern overlay -->
  <div class="absolute inset-0 hexagon-bg opacity-10"></div>
  
  {backgroundImage && (
    <div class="absolute inset-0 opacity-20">
      <img src={backgroundImage} alt="" class="w-full h-full object-cover" />
    </div>
  )}
  
  <div class="relative container-custom section-padding">
    <div class="max-w-4xl">
      <h1 class="text-5xl md:text-6xl lg:text-7xl font-bold mb-6 animate-fade-in">
        {title}
      </h1>
      
      {subtitle && (
        <p class="text-xl md:text-2xl text-blue-100 mb-8 animate-slide-in">
          {subtitle}
        </p>
      )}
      
      {ctaText && ctaLink && (
        <a href={ctaLink} class="btn btn-secondary inline-flex items-center animate-fade-in">
          {ctaText}
          <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
          </svg>
        </a>
      )}
    </div>
  </div>
  
  <!-- Decorative dots -->
  <div class="absolute bottom-0 right-0 w-64 h-64 opacity-10">
    <svg viewBox="0 0 100 100" fill="currentColor">
      <circle cx="10" cy="10" r="2"/>
      <circle cx="30" cy="10" r="2"/>
      <circle cx="50" cy="10" r="2"/>
      <circle cx="70" cy="10" r="2"/>
      <circle cx="90" cy="10" r="2"/>
      <circle cx="10" cy="30" r="2"/>
      <circle cx="30" cy="30" r="2"/>
      <circle cx="50" cy="30" r="2"/>
      <circle cx="70" cy="30" r="2"/>
      <circle cx="90" cy="30" r="2"/>
      <circle cx="10" cy="50" r="2"/>
      <circle cx="30" cy="50" r="2"/>
      <circle cx="50" cy="50" r="2"/>
      <circle cx="70" cy="50" r="2"/>
      <circle cx="90" cy="50" r="2"/>
      <circle cx="10" cy="70" r="2"/>
      <circle cx="30" cy="70" r="2"/>
      <circle cx="50" cy="70" r="2"/>
      <circle cx="70" cy="70" r="2"/>
      <circle cx="90" cy="70" r="2"/>
      <circle cx="10" cy="90" r="2"/>
      <circle cx="30" cy="90" r="2"/>
      <circle cx="50" cy="90" r="2"/>
      <circle cx="70" cy="90" r="2"/>
      <circle cx="90" cy="90" r="2"/>
    </svg>
  </div>
</section>
