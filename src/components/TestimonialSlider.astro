---
const testimonials = [
  {
    text: "V-TECH has been our primary diagnostic partner for over 5 years. Their accuracy and turnaround time are unmatched in the region. We trust them with our most critical cases.",
    author: "Dr. Somchai Rajata",
    role: "Medical Director, City Hospital",
    image: "/images/team/placeholder-1.jpg"
  },
  {
    text: "The level of professionalism and the quality of reports we receive from V-TECH is exceptional. Their online portal makes tracking results incredibly easy for our staff.",
    author: "Nurse Preeti Wong",
    role: "Senior Nurse, Wellness Clinic",
    image: "/images/team/placeholder-2.jpg"
  },
  {
    text: "As a research laboratory, we require absolute precision. V-TECH's commitment to international standards gave us the confidence we needed for our clinical trials.",
    author: "Dr. Ananda Silva",
    role: "Lead Researcher, BioLabs",
    image: "/images/team/placeholder-3.jpg"
  }
];
---

<section class="section-padding bg-white overflow-hidden">
  <div class="container-custom">
    <div class="flex flex-col lg:flex-row items-center gap-16">
      <div class="lg:w-1/3">
        <div class="text-[10px] font-bold text-primary uppercase tracking-[0.4em] mb-4">Testimonials</div>
        <h2 class="text-4xl font-bold font-heading uppercase mb-8 leading-tight">What Our <span class="text-primary italic">Partners</span> Say About Us</h2>
        <p class="text-slate-500 leading-relaxed mb-8">
          We pride ourselves on building long-lasting relationships with healthcare providers through reliability and excellence.
        </p>
        <div class="flex gap-4">
          <button id="prev-testimonial" class="w-12 h-12 rounded-full border border-slate-200 flex items-center justify-center hover:bg-primary hover:border-primary hover:text-white transition-all duration-300">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
          </button>
          <button id="next-testimonial" class="w-12 h-12 rounded-full border border-slate-200 flex items-center justify-center hover:bg-primary hover:border-primary hover:text-white transition-all duration-300">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
          </button>
        </div>
      </div>
      
      <div class="lg:w-2/3 relative">
        <div id="testimonial-container" class="relative overflow-hidden">
          <div id="testimonial-track" class="flex transition-transform duration-500 ease-in-out">
            {testimonials.map((t) => (
              <div class="min-w-full px-4">
                <div class="bg-slate-50 p-10 md:p-16 rounded-3xl relative">
                  <div class="absolute top-10 right-10 opacity-10">
                    <svg class="w-20 h-20 text-primary" fill="currentColor" viewBox="0 0 24 24"><path d="M14.017 21L14.017 18C14.017 16.8954 14.9124 16 16.017 16H19.017C19.5693 16 20.017 15.5523 20.017 15V9C20.017 8.44772 19.5693 8 19.017 8H16.017C15.4647 8 15.017 8.44772 15.017 9V12C15.017 12.5523 14.5693 13 14.017 13H13.017V21H14.017ZM6.01703 21L6.01703 18C6.01703 16.8954 6.91242 16 8.01703 16H11.017C11.5693 16 12.017 15.5523 12.017 15V9C12.017 8.44772 11.5693 8 11.017 8H8.01703C7.46475 8 7.01703 8.44772 7.01703 9V12C7.01703 12.5523 6.56931 13 6.01703 13H5.01703V21H6.01703Z"/></svg>
                  </div>
                  <p class="text-xl md:text-2xl italic text-secondary leading-relaxed mb-10 relative z-10">
                    "{t.text}"
                  </p>
                  <div class="flex items-center gap-6">
                    <div class="w-16 h-16 rounded-full bg-slate-200 overflow-hidden ring-4 ring-white shadow-lg">
                      <div class="w-full h-full flex items-center justify-center text-primary font-bold bg-primary/10">
                        {t.author.charAt(0)}
                      </div>
                    </div>
                    <div>
                      <div class="font-bold text-secondary font-heading uppercase tracking-wide">{t.author}</div>
                      <div class="text-sm text-primary font-medium">{t.role}</div>
                    </div>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const track = document.getElementById('testimonial-track') as HTMLElement;
  const slides = track.querySelectorAll('.min-w-full');
  const prevBtn = document.getElementById('prev-testimonial');
  const nextBtn = document.getElementById('next-testimonial');
  
  let current = 0;
  const total = slides.length;
  
  function update() {
    track.style.transform = `translateX(-${current * 100}%)`;
  }
  
  prevBtn?.addEventListener('click', () => {
    current = (current - 1 + total) % total;
    update();
  });
  
  nextBtn?.addEventListener('click', () => {
    current = (current + 1) % total;
    update();
  });
  
  // Auto switch every 10 seconds
  setInterval(() => {
    current = (current + 1) % total;
    update();
  }, 10000);
</script>
