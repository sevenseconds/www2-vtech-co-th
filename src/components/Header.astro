---
// Header component with 2-row navigation layout
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import LanguagePicker from './LanguagePicker.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<!-- Start: Header Component -->
<header class="bg-white relative z-50">
  <!-- Top Bar: Logo and Info -->
  <div class="pt-6 pb-8 md:pt-12 md:pb-16 bg-white transition-all duration-300 border-b border-slate-50">
    <div class="container-custom flex items-center justify-between text-secondary">
      <!-- Logo -->
      <a href={lang === 'th' ? '/' : `/${lang}/`} class="flex items-center group ml-4">
        <img src="/images/vtech_logo.png" alt="V-TECH Logo" class="h-16 md:h-24 lg:h-32 w-auto object-contain transition-transform duration-300 group-hover:scale-105" />
      </a>

      <!-- Tablet & Desktop Contact Info Blocks -->
      <div class="hidden md:flex flex-1 items-center justify-end gap-x-12 lg:gap-x-16 xl:gap-x-20 pr-4">
        <!-- Telephone Block -->
        <div class="flex items-center gap-4 lg:gap-5">
          <div class="w-12 h-12 lg:w-16 lg:h-16 rounded-full flex items-center justify-center text-primary bg-primary/10 flex-shrink-0">
            <svg class="w-5 h-5 lg:w-7 lg:h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l2.1-2.1a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
            </svg>
          </div>
          <div class="flex flex-col">
            <div class="text-[16px] lg:text-[19px] font-medium text-[#09162a] font-heading leading-tight">{t('contact.telephone')}</div>
            <div class="text-[13px] lg:text-[15px] font-normal text-[#999999] font-heading leading-relaxed">{t('contact.phone_value')}</div>
          </div>
        </div>

        <!-- Email Block -->
        <div class="flex items-center gap-4 lg:gap-5">
          <div class="w-12 h-12 lg:w-16 lg:h-16 rounded-full flex items-center justify-center text-primary bg-primary/10 flex-shrink-0">
            <svg class="w-5 h-5 lg:w-7 lg:h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <rect width="20" height="16" x="2" y="4" rx="2"></rect>
              <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
            </svg>
          </div>
          <div class="flex flex-col">
            <div class="text-[16px] lg:text-[19px] font-medium text-[#09162a] font-heading leading-tight">{t('contact.email')}</div>
            <div class="text-[13px] lg:text-[15px] font-normal text-[#999999] font-heading leading-relaxed">{t('contact.email_value')}</div>
          </div>
        </div>

        <!-- Office Block (Desktop only) -->
        <div class="hidden lg:flex items-center gap-4 lg:gap-5">
          <div class="w-12 h-12 lg:w-16 lg:h-16 rounded-full flex items-center justify-center text-primary bg-primary/10 flex-shrink-0">
            <svg class="w-5 h-5 lg:w-7 lg:h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path>
              <circle cx="12" cy="10" r="3"></circle>
            </svg>
          </div>
          <div class="flex flex-col max-w-[200px] xl:max-w-[250px]">
            <div class="text-[16px] lg:text-[19px] font-medium text-[#09162a] font-heading leading-tight">{t('contact.office')}</div>
            <div class="text-[13px] lg:text-[15px] font-normal text-[#999999] font-heading leading-tight line-clamp-2" title={t('contact.address_value')}>{t('contact.address_value')}</div>
          </div>
        </div>
      </div>

      <!-- Mobile Hamburger Menu Button -->
      <button id="mobile-menu-btn" class="md:hidden p-4 text-secondary hover:text-primary transition-colors">
        <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
      </button>
    </div>
  </div>
</header>

<!-- Tablet & Desktop Bottom Bar: Navigation -->
<nav id="sticky-header" class="hidden md:block relative z-[100] -mt-8 -mb-8 sticky top-0 transition-all duration-300">
  <div id="nav-bg-wrapper" class="w-full transition-all duration-500">
    <div class="container-custom">
      <div id="nav-container" class="bg-primary text-white shadow-2xl flex items-center justify-between transition-all duration-500 h-16">
        <div class="flex items-center h-full">
          <div id="sticky-logo-container" class="hidden h-full items-center mr-4 lg:mr-8">
            <a href="/" class="flex items-center">
              <img src="/images/vtech_logo.png" alt="V-TECH Logo" class="h-10 lg:h-12 w-auto object-contain" />
            </a>
          </div>

          <div class="flex items-center h-full nav-links">
            <a href={lang === 'th' ? '/' : `/${lang}/`} class="px-3 lg:px-6 h-full flex items-center hover:bg-black/10 font-heading font-bold uppercase text-[12px] lg:text-[14px] tracking-[1px] transition-colors nav-link">{t('nav.home')}</a>
            <a href={lang === 'th' ? '/about' : `/${lang}/about`} class="px-3 lg:px-6 h-full flex items-center hover:bg-black/10 font-heading font-bold uppercase text-[12px] lg:text-[14px] tracking-[1px] transition-colors nav-link">{t('nav.about')}</a>
            <a href={lang === 'th' ? '/services' : `/${lang}/services`} class="px-3 lg:px-6 h-full flex items-center hover:bg-black/10 font-heading font-bold uppercase text-[12px] lg:text-[14px] tracking-[1px] transition-colors nav-link">{t('nav.services')}</a>
            <a href={lang === 'th' ? '/blog' : `/${lang}/blog`} class="px-3 lg:px-6 h-full flex items-center hover:bg-black/10 font-heading font-bold uppercase text-[12px] lg:text-[14px] tracking-[1px] transition-colors nav-link">{t('nav.blog')}</a>
            <a href={lang === 'th' ? '/contact' : `/${lang}/contact`} class="px-3 lg:px-6 h-full flex items-center hover:bg-black/10 font-heading font-bold uppercase text-[12px] lg:text-[14px] tracking-[1px] transition-colors nav-link">{t('nav.contacts')}</a>
          </div>
        </div>

        <div class="flex items-center h-full">
          <div class="h-full flex items-center px-2 lg:px-4 border-l border-white/10">
            <LanguagePicker />
          </div>
          <a id="consultation-btn" href="tel:027425340" class="bg-secondary text-white px-4 lg:px-10 h-full flex items-center font-heading font-bold uppercase text-[12px] lg:text-[14px] tracking-[1px] hover:bg-white hover:text-secondary transition-all duration-300">
            {t('nav.call_us')}
          </a>
        </div>
      </div>
    </div>
  </div>
</nav>

<!-- Fullscreen Mobile Menu Overlay -->
<div id="mobile-menu-overlay" class="fixed inset-0 bg-primary z-[200] flex flex-col items-center justify-center translate-x-full transition-transform duration-500 ease-in-out md:hidden">
  <button id="close-mobile-menu" class="absolute top-10 right-10 text-white hover:text-secondary transition-colors">
    <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
  </button>
  
  <div class="flex flex-col items-center space-y-8 font-heading font-bold uppercase text-2xl tracking-[2px] text-white">
    <a href={lang === 'th' ? '/' : `/${lang}/`} class="hover:text-secondary transition-colors">{t('nav.home')}</a>
    <a href={lang === 'th' ? '/about' : `/${lang}/about`} class="hover:text-secondary transition-colors">{t('nav.about')}</a>
    <a href={lang === 'th' ? '/services' : `/${lang}/services`} class="hover:text-secondary transition-colors">{t('nav.services')}</a>
    <a href={lang === 'th' ? '/blog' : `/${lang}/blog`} class="hover:text-secondary transition-colors">{t('nav.blog')}</a>
    <a href={lang === 'th' ? '/contact' : `/${lang}/contact`} class="hover:text-secondary transition-colors">{t('nav.contacts')}</a>
    
    <div class="pt-8 scale-150">
      <LanguagePicker />
    </div>
  </div>
</div>

<script>
  // Sticky Logic
  const navContainer = document.getElementById('nav-container');
  const navBgWrapper = document.getElementById('nav-bg-wrapper');
  const stickyLogoContainer = document.getElementById('sticky-logo-container');
  const navLinksList = document.querySelectorAll('.nav-link');

  const handleScroll = () => {
    if (window.scrollY > 160) {
      navBgWrapper?.classList.add('bg-white', 'shadow-xl');
      navContainer?.classList.remove('bg-primary', 'text-white', 'shadow-2xl');
      navContainer?.classList.add('bg-white', 'text-secondary', 'h-24'); // Increased height
      navContainer?.classList.remove('h-16');
      stickyLogoContainer?.classList.remove('hidden');
      stickyLogoContainer?.classList.add('flex');
      
      // Update logo size for sticky mode
      const logoImg = stickyLogoContainer?.querySelector('img');
      if (logoImg) {
        logoImg.classList.remove('h-10', 'lg:h-12');
        logoImg.classList.add('h-14', 'lg:h-16');
      }

      // Keep consultation button the same size
      const consultBtn = document.getElementById('consultation-btn');
      if (consultBtn) {
        consultBtn.classList.remove('h-full');
        consultBtn.classList.add('h-16');
      }

      navLinksList.forEach(a => {
        a.classList.remove('text-white');
        a.classList.add('text-secondary');
      });
    } else {
      navBgWrapper?.classList.remove('bg-white', 'shadow-xl');
      navContainer?.classList.add('bg-primary', 'text-white', 'shadow-2xl');
      navContainer?.classList.remove('bg-white', 'text-secondary', 'h-24');
      navContainer?.classList.add('h-16');
      stickyLogoContainer?.classList.add('hidden');
      stickyLogoContainer?.classList.remove('flex');

      // Reset consultation button
      const consultBtn = document.getElementById('consultation-btn');
      if (consultBtn) {
        consultBtn.classList.add('h-full');
        consultBtn.classList.remove('h-16');
      }

      navLinksList.forEach(a => {
        a.classList.add('text-white');
        a.classList.remove('text-secondary');
      });
    }
  };

  if (window.innerWidth >= 768) {
    window.addEventListener('scroll', handleScroll);
    handleScroll();
  }

  // Mobile Menu Logic
  const mobileMenuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenuOverlay = document.getElementById('mobile-menu-overlay');
  const closeMobileMenu = document.getElementById('close-mobile-menu');

  mobileMenuBtn?.addEventListener('click', () => {
    mobileMenuOverlay?.classList.remove('translate-x-full');
    document.body.style.overflow = 'hidden'; // Prevent scroll
  });

  closeMobileMenu?.addEventListener('click', () => {
    mobileMenuOverlay?.classList.add('translate-x-full');
    document.body.style.overflow = ''; // Restore scroll
  });

  // Close menu on link click
  const mobileLinks = mobileMenuOverlay?.querySelectorAll('a');
  mobileLinks?.forEach(link => {
    link.addEventListener('click', () => {
      mobileMenuOverlay?.classList.add('translate-x-full');
      document.body.style.overflow = '';
    });
  });
</script>
