---
interface Props {
  title: string;
  description: string;
  pubDate: Date;
  image?: string;
  slug: string;
  tags?: string[];
}

const { title, description, pubDate, image, slug, tags = [] } = Astro.props;

const formattedDate = pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
});
---

<article class="flex flex-col h-full bg-white shadow-[0_10px_30px_rgba(0,0,0,0.03)] hover:shadow-[0_20px_60px_rgba(0,0,0,0.08)] transition-all duration-500 overflow-hidden group">
  {image && (
    <div class="relative aspect-video overflow-hidden">
      <img 
        src={image} 
        alt={title} 
        class="w-full h-full object-cover transform group-hover:scale-110 transition-transform duration-1000"
        loading="lazy"
      />
      <!-- Date Badge Overlay -->
      <div class="absolute top-6 left-6 bg-primary text-white text-[10px] font-bold uppercase tracking-[0.2em] px-4 py-2 shadow-xl">
        {formattedDate}
      </div>
      <!-- Hover Overlay -->
      <div class="absolute inset-0 bg-secondary/20 opacity-0 group-hover:opacity-100 transition-opacity duration-500 flex items-center justify-center">
        <div class="w-12 h-12 bg-white rounded-full flex items-center justify-center text-secondary scale-0 group-hover:scale-100 transition-transform duration-500">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
        </div>
      </div>
    </div>
  )}
  
  <div class="p-8 md:p-10 flex flex-col flex-grow">
    <div class="flex items-center gap-4 mb-6">
       {tags.length > 0 && (
        <span class="text-primary text-[10px] font-bold uppercase tracking-widest">{tags[0]}</span>
      )}
      <div class="flex-grow h-[1px] bg-slate-100"></div>
    </div>
    
    <h3 class="text-2xl font-bold mb-6 text-secondary group-hover:text-primary transition-colors font-heading leading-tight uppercase tracking-tight">
      <a href={`/blog/${slug}`}>{title}</a>
    </h3>
    
    <p class="text-slate-500 mb-10 text-[15px] leading-relaxed line-clamp-3">
      {description}
    </p>
    
    <div class="mt-auto pt-8 border-t border-slate-50 flex items-center justify-between">
      <a href={`/blog/${slug}`} class="group/link flex items-center text-secondary hover:text-primary font-bold uppercase text-[11px] tracking-[0.2em] transition-all">
        Read More
        <div class="ml-4 w-10 h-10 rounded-full border border-slate-200 flex items-center justify-center group-hover/link:bg-primary group-hover/link:border-primary group-hover/link:text-white transition-all duration-300">
           <svg class="w-4 h-4 transform group-hover/link:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
          </svg>
        </div>
      </a>
    </div>
  </div>
</article>
