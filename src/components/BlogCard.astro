---
interface Props {
  title: string;
  description: string;
  pubDate: Date;
  image?: string;
  slug: string;
  tags?: string[];
}

const { title, description, pubDate, image, slug, tags = [] } = Astro.props;

const formattedDate = pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
});
---

<article class="card group">
  {image && (
    <div class="aspect-video bg-slate-100 rounded-lg mb-4 overflow-hidden -mx-6 -mt-6">
      <img 
        src={image} 
        alt={title} 
        class="w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-500"
        loading="lazy"
      />
    </div>
  )}
  
  <div class="flex items-center gap-2 text-sm text-slate-500 mb-3">
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
    </svg>
    <time datetime={pubDate.toISOString()}>{formattedDate}</time>
  </div>
  
  <h3 class="text-2xl font-bold mb-3 group-hover:text-blue-900 transition-colors">
    <a href={`/blog/${slug}`}>{title}</a>
  </h3>
  
  <p class="text-slate-600 mb-4 line-clamp-3">{description}</p>
  
  {tags.length > 0 && (
    <div class="flex flex-wrap gap-2 mb-4">
      {tags.map(tag => (
        <span class="bg-blue-100 text-blue-900 text-xs px-3 py-1 rounded-full">
          {tag}
        </span>
      ))}
    </div>
  )}
  
  <a href={`/blog/${slug}`} class="text-blue-900 font-semibold inline-flex items-center hover:gap-3 gap-2 transition-all">
    Read More
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
    </svg>
  </a>
</article>
